generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}

model Level {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String
  exercises Exercise[]
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String
  exercises Exercise[]
}

model Exercise {
  id               Int     @id @default(autoincrement())
  title            String
  description      String?
  instructionTitle String
  instruction      String

  image String

  isFavorite Boolean

  calory String?

  tag Category[]

  levelId Int
  level   Level @relation(fields: [levelId], references: [id])
}
